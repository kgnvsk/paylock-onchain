# PayLock — Solana side (existing, for Anchor tests/deploy)
ANCHOR_WALLET=/root/.config/solana/id.json
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# PayLock — Base (EVM) side (new, Phase 2)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=<get-from-basescan.org>
# Admin wallet — generates ownership of PaylockEscrow contract. KEEP SECRET.
BASE_ADMIN_PRIVATE_KEY=<0x...>
# Treasury wallet — receives fees (separate from admin).
BASE_TREASURY_ADDRESS=<0x...>
# Deployed contract addresses (filled post-deploy)
BASE_ESCROW_ADDRESS=
BASE_SEPOLIA_ESCROW_ADDRESS=
# USDC addresses (canonical, do not change)
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
